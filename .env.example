OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phone-commander
OLLAMA_TIMEOUT_MS=180000

# Appium is the condition-based backend; adb keeps the legacy executor.
ANDROID_EXECUTOR_BACKEND=appium
APPIUM_URL=http://127.0.0.1:4723
# Optional: absolute path to a separately approved Chrome-compatible driver.
# APPIUM_CHROMEDRIVER_EXECUTABLE=C:/path/to/chromedriver.exe
# Optional MJPEG forwarding; static Dashboard previews do not need it.
# APPIUM_ENABLE_MJPEG=true
# Set APPIUM_HOME only when drivers are installed outside ~/.appium.
# Set ADB_PATH to the full adb.exe path if it is not available on PATH.

# Appium video_list uses the exploration budget; other WAIT_FOR targets keep timeoutMs.
ANDROID_EXPLORATION_MAX_SCROLLS=24
ANDROID_EXPLORATION_TIMEOUT_MS=120000
ANDROID_EXPLORATION_SCROLL_PERCENT=0.35
ANDROID_EXPLORATION_EMPTY_VIDEO_SCROLL_PERCENT=0.9
ANDROID_EXPLORATION_VIDEO_SCROLL_PERCENT=0.6
ANDROID_EXPLORATION_SCROLL_SPEED=700
ANDROID_EXPLORATION_MAX_UNCHANGED=2
ANDROID_EXPLORATION_SETTLE_TIMEOUT_MS=4000
ANDROID_EXPLORATION_MAX_ELEMENTS=150
ANDROID_OBSERVER_IDLE_TIMEOUT_MS=1000
